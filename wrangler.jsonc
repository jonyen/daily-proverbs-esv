{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daily-proverbs-esv",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-12",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "SLACK_CHANNEL": "#dailyproverbs"
  },
  "triggers": {
    "crons": ["0 2 * * *"]
  }
}